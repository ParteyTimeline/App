# Copy this file to .env and fill in real values.
# `docker compose up` and `npm start` both read from .env automatically.

# Required for logins to survive a server restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 1 when the app is served over HTTPS (directly or behind a reverse
# proxy) so session cookies get the `Secure` flag. Leave at 0 for plain HTTP
# local development.
COOKIE_SECURE=0

# Port the Node process listens on (the Docker image always maps its
# internal 3000 to whatever host port you choose in docker-compose.yml —
# this only matters for `npm start` without Docker).
PORT=3000

# Sent as the User-Agent on every MusicBrainz lookup (used to correct
# release years — see src/musicbrainz.js). MusicBrainz's API etiquette asks
# for something that identifies your app and gives them a way to reach you
# if it ever needs throttling by contact instead of by IP. Example:
#   MyPartyGame/1.0 (me@example.com)
MUSICBRAINZ_USER_AGENT=

# Gates the "manage playlists" screen (rename/delete/clear-cache/import) —
# without it, anyone who's just logged in could wipe out playlists other
# players contributed. Set to a bcrypt hash of your chosen admin password
# (not the plain password itself), generated with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# Leave unset to disable playlist management entirely. Not needed for the
# Android app's own host device, which authenticates itself automatically.
ADMIN_PASSWORD_HASH=
