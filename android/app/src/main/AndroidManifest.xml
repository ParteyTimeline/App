<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Nearby Connections — exact list from Google's own integration guide
         (developers.google.com/nearby/connections/android/get-started),
         version-gated because the underlying permission model changed
         across Android 12/13. -->
    <!-- Unlike the Bluetooth/location permissions below, these two are
         "normal" (not runtime-dangerous) and NOT superseded by anything on
         API 32+ — Nearby Connections' WIFI_LAN/WIFI_AWARE/WIFI_DIRECT/
         WIFI_HOTSPOT mediums check for them unconditionally regardless of
         Android version. An earlier maxSdkVersion="31" cap here (mistakenly
         modeled on the Bluetooth permissions' actual version-gating) made
         startAdvertising()/startDiscovery() fail outright on Android 13+
         with "Missing permission: ... ACCESS_WIFI_STATE" — silently, since
         it's not a runtime grant so there was no permission-denial dialog
         to notice. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:maxSdkVersion="30" android:name="android.permission.BLUETOOTH" />
    <uses-permission android:maxSdkVersion="30" android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- Google's own guide caps this at maxSdkVersion="28" (superseded by
         ACCESS_FINE_LOCATION 29-31, then NEARBY_WIFI_DEVICES 32+) — but real
         on-device testing (Android 13, API 33) showed startDiscovery() still
         failing with ApiException 8034 (MISSING_PERMISSION_
         ACCESS_COARSE_LOCATION) even with NEARBY_WIFI_DEVICES granted.
         NEARBY_WIFI_DEVICES only covers Nearby Connections' Wi-Fi-based
         mediums; its BLE medium still goes through the classic
         location-gated scan path regardless of Android version. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Same story as ACCESS_COARSE_LOCATION just above, found the same way:
         Google's guide caps this at maxSdkVersion="31" (superseded by
         NEARBY_WIFI_DEVICES on 32+), but on-device testing showed the PEER
         side's startDiscovery() failing on Android 13 with ApiException
         8036 (MISSING_PERMISSION_ACCESS_FINE_LOCATION) — asymmetric with the
         host side, which only needed COARSE. Nearby Connections' Wi-Fi LAN
         medium apparently needs FINE specifically for scanning (reading Wi-Fi
         scan results has required FINE, not COARSE, since Android 8), even
         though advertising over the same medium didn't. -->
    <uses-permission android:minSdkVersion="29" android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:minSdkVersion="32" android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Keeping the embedded server + Nearby advertising alive as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ParteyTimelineNearby"
        android:usesCleartextTraffic="true">

        <!-- Cleartext (plain http://127.0.0.1) is required: the WebView
             talks to the embedded Node server or the local tunnel port, both
             plain HTTP loopback — never leaves the device. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameWebViewActivity"
            android:exported="false" />

        <service
            android:name=".host.HostForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
