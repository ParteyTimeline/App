<?xml version="1.0" encoding="utf-8"?>
<!-- A vinyl record, echoing the in-game flip-card reveal (dark disc, gold
     rim) and the teal "gap-slot" timeline accents from public/styles.css —
     kept within the 66dp safe-zone circle of the 108x108dp adaptive-icon
     canvas so it survives every launcher mask shape (circle/squircle/etc). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:name="disc"
        android:pathData="M24,54 A30,30 0 1,0 84,54 A30,30 0 1,0 24,54 Z"
        android:fillColor="#1D1233"
        android:strokeColor="#FFB627"
        android:strokeWidth="2.5" />

    <path
        android:name="groove1"
        android:pathData="M30,54 A24,24 0 1,0 78,54 A24,24 0 1,0 30,54 Z"
        android:fillColor="#00000000"
        android:strokeColor="#0E8A8A"
        android:strokeAlpha="0.9"
        android:strokeWidth="1.2" />

    <path
        android:name="groove2"
        android:pathData="M35,54 A19,19 0 1,0 73,54 A19,19 0 1,0 35,54 Z"
        android:fillColor="#00000000"
        android:strokeColor="#0E8A8A"
        android:strokeAlpha="0.7"
        android:strokeWidth="1.2" />

    <path
        android:name="groove3"
        android:pathData="M40,54 A14,14 0 1,0 68,54 A14,14 0 1,0 40,54 Z"
        android:fillColor="#00000000"
        android:strokeColor="#0E8A8A"
        android:strokeAlpha="0.5"
        android:strokeWidth="1.2" />

    <path
        android:name="label"
        android:pathData="M44,54 A10,10 0 1,0 64,54 A10,10 0 1,0 44,54 Z"
        android:fillColor="#FFB627"
        android:strokeColor="#1D1233"
        android:strokeWidth="1.2" />

    <path
        android:name="spindle"
        android:pathData="M52.2,54 A1.8,1.8 0 1,0 55.8,54 A1.8,1.8 0 1,0 52.2,54 Z"
        android:fillColor="#1D1233" />
</vector>
